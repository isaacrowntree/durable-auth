{
  // The example app: `npm run example` from the repo root, then open
  // http://localhost:8790. Also what the end-to-end suite drives.
  "name": "durable-auth-example",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "AUTH", "class_name": "Auth" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Auth"] }],
  // Locally, sent mail is written under .wrangler/tmp/email/ instead.
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "EMAIL_FROM": "noreply@example.com",
    // Local only. A real deploy keeps this out of the config:
    // `openssl rand -base64 32 | wrangler secret put CODE_SECRET`.
    "CODE_SECRET": "example-only-not-a-secret-example-only"
  },
  "dev": { "port": 8790 }
}
