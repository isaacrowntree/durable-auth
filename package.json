{
  "name": "durable-auth",
  "version": "0.3.1",
  "description": "Passkey sign-in for Cloudflare Workers, kept in one Durable Object: accounts, sessions and email recovery, no auth service and no user database.",
  "license": "MIT",
  "author": "Isaac Rowntree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacrowntree/durable-auth.git"
  },
  "homepage": "https://isaacrowntree.com/durable-auth/",
  "bugs": {
    "url": "https://github.com/isaacrowntree/durable-auth/issues"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "workers",
    "passkeys",
    "webauthn",
    "auth",
    "authentication",
    "sessions",
    "passwordless"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node examples/basic/build.mjs && playwright test",
    "example": "node examples/basic/build.mjs && wrangler dev --config examples/basic/wrangler.jsonc",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
